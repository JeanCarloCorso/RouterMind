# Gere com: python -c 'import secrets; print(secrets.token_urlsafe(48))'
ROUTEMIND_SECRET_KEY=change-me-with-at-least-32-random-characters
ROUTEMIND_DATABASE_PATH=routemind.db
ROUTEMIND_ENVIRONMENT=development
ROUTEMIND_SECURE_COOKIES=false
ROUTEMIND_CATALOG_TTL_SECONDS=900
ROUTEMIND_CATALOG_MAX_STALE_SECONDS=3600
ROUTEMIND_REQUEST_TIMEOUT_SECONDS=120
ROUTEMIND_DEFAULT_OUTPUT_TOKENS=1024
ROUTEMIND_RATE_LIMIT_PER_MINUTE=60
ROUTEMIND_MAX_FALLBACK_ATTEMPTS=2
ROUTEMIND_APP_URL=https://openrouter.ai
ROUTEMIND_APP_NAME=RouteMind
